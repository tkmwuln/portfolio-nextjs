generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.Text
  name         String     @db.VarChar(100)
  role         String     @default("admin") @db.VarChar(20)
  avatarUrl    String?    @map("avatar_url") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz

  projects  Project[]
  blogPosts BlogPost[]

  @@map("users")
}

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.Text
  color       String?   @db.VarChar(7)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  projects Project[]

  @@map("categories")
}

model Project {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String?   @map("category_id") @db.Uuid
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy     String?   @map("created_by") @db.Uuid
  user          User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  
  title         String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(280)
  summary       String?   @db.Text
  content       String?   @db.Text
  coverImageUrl String?   @map("cover_image_url") @db.Text
  status        String    @default("draft") @db.VarChar(20)
  sortOrder     Int       @default(0) @map("sort_order")
  clientName    String?   @map("client_name") @db.VarChar(150)
  projectYear   Int?      @map("project_year") @db.SmallInt
  durationWeeks Int?      @map("duration_weeks") @db.SmallInt
  role          String?   @db.VarChar(150)
  
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  metrics projectMetric[]
  images  projectImage[]

  @@map("projects")
}

model projectMetric {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metricLabel String   @map("metric_label") @db.VarChar(100)
  metricValue String   @map("metric_value") @db.VarChar(50)
  metricUnit  String?  @map("metric_unit") @db.VarChar(30)
  metricDelta String?  @map("metric_delta") @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")

  @@map("project_metrics")
}

model projectImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String   @map("image_url") @db.Text
  altText   String?  @map("alt_text") @db.VarChar(255)
  caption   String?  @db.Text
  sortOrder Int      @default(0) @map("sort_order")

  @@map("project_images")
}

model BlogPost {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId      String?   @map("author_id") @db.Uuid
  user          User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  
  title         String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(280)
  excerpt       String?   @db.Text
  content       String?   @db.Text
  coverImageUrl String?   @map("cover_image_url") @db.Text
  readTimeMin   Int?      @map("read_time_min") @db.SmallInt
  status        String    @default("draft") @db.VarChar(20)
  
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  tags Tag[] @relation("BlogTags")

  @@map("blog_posts")
}

model Tag {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar(80)
  slug String @unique @db.VarChar(100)

  posts BlogPost[] @relation("BlogTags")

  @@map("tags")
}

model Profile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(150)
  headline     String?  @db.VarChar(255)
  bio          String?  @db.Text
  avatarUrl    String?  @map("avatar_url") @db.Text
  location     String?  @db.VarChar(100)
  emailContact String?  @map("email_contact") @db.VarChar(255)
  linkedinUrl  String?  @map("linkedin_url") @db.Text
  dribbbleUrl  String?  @map("dribbble_url") @db.Text
  resumeUrl    String?  @map("resume_url") @db.Text
  openToWork   Boolean  @default(false) @map("open_to_work")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("profile")
}
